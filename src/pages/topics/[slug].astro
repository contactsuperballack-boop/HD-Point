---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Newsletter from '../../components/Newsletter.astro';
import { latestPosts, topicPosts } from '../../data/posts';
import { TOPICS } from '../../data/topics';

export function getStaticPaths() { return TOPICS.map((t) => ({ params: { slug: t.slug } })); }
const topic = TOPICS.find((t) => t.slug === Astro.params.slug);
const posts = await topicPosts(topic.slug);                                   // posts not already on Latest
const onLatest = (await latestPosts()).filter((p) => p.data.topic === topic.slug).length;
---
<Base title={topic.label} description={topic.blurb}>
  <header class="max-w-2xl pt-14 pb-10 md:pt-20">
    <p class="text-xs font-semibold uppercase tracking-widest text-muted">Topic</p>
    <h1 class="mt-3 font-head text-5xl font-bold uppercase leading-none text-ink md:text-7xl">{topic.label}</h1>
    <p class="mt-5 text-lg text-muted">{topic.blurb}</p>
  </header>
  {posts.length > 0 ? <PostList posts={posts} /> : (
    <div class="rounded-2xl border border-rule bg-surface p-8 text-muted">
      <p>No other {topic.label} stories yet.</p>
    </div>
  )}
  {onLatest > 0 && (
    <p class="mt-8 text-sm text-muted">{onLatest === 1 ? 'One more' : `${onLatest} more`} {topic.label} {onLatest === 1 ? 'story is' : 'stories are'} featured in <a class="text-accent" href="/#latest">Latest</a>.</p>
  )}
  <Newsletter place="topic" />
</Base>
