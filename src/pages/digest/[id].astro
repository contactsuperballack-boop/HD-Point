---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { allDigests } from '../../data/digests';
import { fmtDate } from '../../data/format';
export function getStaticPaths() { return allDigests().map((d) => ({ params: { id: d.id }, props: { d } })); }
const { d } = Astro.props;
---
<Base title={d.title} description={d.summary}>
  <article class="narrow">
    <p class="meta">Weekly digest, {fmtDate(new Date(d.date))} {d.draft && <span class="chip draft">Draft, not public</span>}</p>
    <h1>{d.title}</h1>
    <div class="prose" set:html={d.html} />
    <Newsletter place="digest-issue" />
  </article>
</Base>
