---
import Base from '../layouts/Base.astro';

// Set PUBLIC_SUBMIT_URL to your deployed worker URL (see README).
const endpoint = import.meta.env.PUBLIC_SUBMIT_URL ?? '';
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const types = [
  ['product_launch', 'A new product'],
  ['model_launch', 'A new AI model'],
  ['startup_feature', 'Our startup'],
  ['funding', 'A funding round'],
  ['skills_guide', 'Skills or training'],
];
const topics = [['ai', 'AI'], ['innovation', 'Innovation'], ['leisure', 'Leisure'], ['lifestyle', 'Lifestyle']];
const first = [0, 1];
const more = [2, 3, 4];
---
<Base title="Submit a startup or product" description="Send us a product, model launch or funding news from your AI startup in Africa.">
  <div class="narrow">
    <h1 class="pagetitle">Submit a startup or product</h1>
    <p class="lead">Tell us about a product, model launch or funding round. We read every submission before anything is published. If we publish it, the post is labelled as a featured submission, and anything we could not check independently is shown as what your company says. Sending a submission does not guarantee a post.</p>

    {!endpoint && <p class="notice">Submissions are not open yet.</p>}

    {endpoint && (
      <form id="submit" data-endpoint={endpoint} data-turnstile={sitekey ? "on" : undefined} novalidate>
        <div id="errors" class="formerrors" role="alert" tabindex="-1" hidden></div>

        <label>What are you announcing?
          <select id="storyType" name="storyType" required>
            {types.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </label>
        <label>Topic
          <select id="topic" name="topic"><option value="">Not sure</option>{topics.map(([v, l]) => <option value={v}>{l}</option>)}</select>
        </label>
        <label>Headline
          <span class="hint">One plain sentence, up to 120 characters.</span>
          <input id="headline" name="headline" maxlength="120" required />
        </label>

        <div class="two">
          <label>Company name <input id="company" name="company" maxlength="80" autocomplete="organization" required /></label>
          <label>Company website <input id="website" name="website" type="url" placeholder="https://" autocomplete="url" required /></label>
        </div>
        <div class="two">
          <label>Country <input id="country" name="country" maxlength="60" autocomplete="country-name" required /></label>
          <label>City <input id="city" name="city" maxlength="60" autocomplete="address-level2" /></label>
        </div>

        <h2 class="formh">Facts</h2>
        <p class="hint">Add 2 to 5 facts. Each fact needs a link where it can be checked, such as a press release, product page or documentation. If a fact includes a number, fill in the figure fields too and make sure the same number appears in the fact.</p>

        {first.map((i) => (
          <fieldset>
            <legend>Fact {i + 1}</legend>
            <label>Fact <textarea id={`fact_${i}`} name={`fact_${i}`} rows="2" maxlength="220"></textarea></label>
            <label>Source link <input id={`url_${i}`} name={`url_${i}`} type="url" placeholder="https://" /></label>
            <div class="three">
              <label>Figure <input name={`value_${i}`} inputmode="decimal" placeholder="12000" /></label>
              <label>Unit <input name={`unit_${i}`} maxlength="30" placeholder="calls" /></label>
              <label>What it measures <input name={`label_${i}`} maxlength="40" placeholder="Pilot calls" /></label>
            </div>
          </fieldset>
        ))}

        <details class="more">
          <summary>Add more facts (optional)</summary>
          {more.map((i) => (
            <fieldset>
              <legend>Fact {i + 1}</legend>
              <label>Fact <textarea id={`fact_${i}`} name={`fact_${i}`} rows="2" maxlength="220"></textarea></label>
              <label>Source link <input id={`url_${i}`} name={`url_${i}`} type="url" placeholder="https://" /></label>
              <div class="three">
                <label>Figure <input name={`value_${i}`} inputmode="decimal" placeholder="12000" /></label>
                <label>Unit <input name={`unit_${i}`} maxlength="30" placeholder="calls" /></label>
                <label>What it measures <input name={`label_${i}`} maxlength="40" placeholder="Pilot calls" /></label>
              </div>
            </fieldset>
          ))}
        </details>

        <label>Official video or social post (optional)
          <span class="hint">A link to YouTube, X, LinkedIn, Vimeo, Instagram, Facebook or TikTok.</span>
          <input id="embedUrl" name="embedUrl" type="url" placeholder="https://" />
        </label>
        <label>Contact email
          <span class="hint">Used only to contact you about this submission. It is not published.</span>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </label>

        <label class="check"><input id="consent_accuracy" type="checkbox" name="consent_accuracy" /> I confirm these facts are accurate and I am allowed to submit them for my company.</label>
        <label class="check"><input id="consent_label" type="checkbox" name="consent_label" /> I understand the post will be labelled as a featured submission and my company's claims will be shown as company statements.</label>

        <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website_url_confirm" tabindex="-1" autocomplete="off" /></label></div>

        {sitekey && <div class="cf-turnstile" data-sitekey={sitekey}></div>}

        <button type="submit" id="send">Send submission</button>
        <p id="status" role="status"></p>
      </form>
    )}
  </div>

  {sitekey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline>
    (function () {
      var f = document.getElementById('submit');
      if (!f) return;
      var errBox = document.getElementById('errors'), status = document.getElementById('status'), btn = document.getElementById('send');
      function val(n) { var el = f.elements[n]; return el ? el.value.trim() : ''; }
      // errors: [{ msg, field }]. Each message links to its field so keyboard and screen-reader users can jump to it.
      function showErrors(list) {
        [].forEach.call(f.querySelectorAll('[aria-invalid]'), function (el) { el.removeAttribute('aria-invalid'); });
        errBox.textContent = '';
        var p = document.createElement('p'), b = document.createElement('strong'); b.textContent = 'Please fix the following:'; p.appendChild(b); errBox.appendChild(p);
        var ul = document.createElement('ul');
        list.forEach(function (e) {
          var li = document.createElement('li');
          if (e.field && document.getElementById(e.field)) {
            document.getElementById(e.field).setAttribute('aria-invalid', 'true');
            var a = document.createElement('a'); a.href = '#' + e.field; a.textContent = e.msg;
            a.addEventListener('click', function (ev) { ev.preventDefault(); var t = document.getElementById(e.field); var d = t.closest('details'); if (d) d.open = true; t.focus(); });
            li.appendChild(a);
          } else { li.textContent = e.msg; }
          ul.appendChild(li);
        });
        errBox.appendChild(ul); errBox.hidden = false; errBox.focus();
      }
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        errBox.hidden = true; status.textContent = '';
        [].forEach.call(f.querySelectorAll('[aria-invalid]'), function (el) { el.removeAttribute('aria-invalid'); });
        var claims = [], errs = [];
        for (var i = 0; i < 5; i++) {
          var t = val('fact_' + i), u = val('url_' + i);
          if (!t && !u) continue;
          claims.push({ text: t, sourceUrl: u, value: val('value_' + i), unit: val('unit_' + i), label: val('label_' + i) });
          if (!t) errs.push({ msg: 'Fact ' + (i + 1) + ' needs the fact text.', field: 'fact_' + i });
          else if (!u) errs.push({ msg: 'Fact ' + (i + 1) + ' needs a source link.', field: 'url_' + i });
        }
        if (!val('headline')) errs.unshift({ msg: 'Add a headline.', field: 'headline' });
        if (!val('company')) errs.push({ msg: 'Add your company name.', field: 'company' });
        if (!val('website')) errs.push({ msg: 'Add your company website.', field: 'website' });
        if (!val('country')) errs.push({ msg: 'Add your country.', field: 'country' });
        if (!val('email')) errs.push({ msg: 'Add a contact email.', field: 'email' });
        if (claims.filter(function (c) { return c.text && c.sourceUrl; }).length < 2) errs.push({ msg: 'Add at least two facts, each with a source link.', field: claims.length ? 'fact_1' : 'fact_0' });
        if (!f.elements.consent_accuracy.checked) errs.push({ msg: 'Confirm the facts are accurate.', field: 'consent_accuracy' });
        if (!f.elements.consent_label.checked) errs.push({ msg: 'Confirm you understand how the post is labelled.', field: 'consent_label' });
        if (f.dataset.turnstile && !val('cf-turnstile-response')) errs.push({ msg: 'Complete the spam check above the Send button.' });
        if (errs.length) { showErrors(errs); return; }
        btn.disabled = true; status.textContent = 'Sending...';
        fetch(f.dataset.endpoint, {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            storyType: val('storyType'), topic: val('topic'), headline: val('headline'), company: val('company'), website: val('website'), country: val('country'), city: val('city'),
            embedUrl: val('embedUrl'), email: val('email'), claims: claims, consent: true, website_url_confirm: val('website_url_confirm'), 'cf-turnstile-response': val('cf-turnstile-response')
          })
        }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            btn.disabled = false;
            if (window.turnstile) window.turnstile.reset();
            if (res.ok) { if (window.track) window.track('Submission sent'); f.reset(); status.textContent = 'Thank you. We have your submission and will review it. We will email you if we need anything else.'; }
            else { status.textContent = ''; showErrors([{ msg: res.j.error || 'Something went wrong. Please try again.' }]); }
          })
          .catch(function () { btn.disabled = false; status.textContent = ''; showErrors([{ msg: 'We could not reach the server. Check your connection and try again.' }]); });
      });
    })();
  </script>
</Base>
