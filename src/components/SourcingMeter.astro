---
// Solid square = verified claim. Hollow square = company says. The words are always shown, not just the shapes.
const { verified = 0, stated = 0, legend = false, compact = false } = Astro.props;
---
{compact ? (
  <span class="inline-flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold uppercase tracking-wider text-muted">
    {verified > 0 && <span class="inline-flex items-center gap-1.5"><i class="block size-2.5 rounded-sm bg-brand"></i>{verified} verified</span>}
    {stated > 0 && <span class="inline-flex items-center gap-1.5"><i class="block size-2.5 rounded-sm border-2 border-stated"></i>{stated} company says</span>}
  </span>
) : (
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold text-muted">
    <span class="inline-flex flex-wrap items-center gap-1" aria-hidden="true">
      {Array.from({ length: verified }).map(() => <i class="block size-3 rounded-sm bg-brand"></i>)}
      {Array.from({ length: stated }).map(() => <i class="block size-3 rounded-sm border-2 border-stated"></i>)}
    </span>
    <span>{[verified ? `${verified} verified` : '', stated ? `${stated} company says` : ''].filter(Boolean).join(', ')}</span>
  </div>
)}
{legend && <p class="mt-3 text-sm text-muted">Solid squares are verified claims. Hollow squares are what the company says. <a class="text-accent" href="/how-we-verify/">How we verify</a></p>}
