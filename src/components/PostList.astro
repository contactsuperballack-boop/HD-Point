---
import PostCard from './PostCard.astro';
const { posts, lead = false } = Astro.props;
---
<ul id="posts" class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
  {posts.map((p, i) => <PostCard post={p} lead={lead && i === 0} />)}
</ul>
<p id="nomatch" role="status" class="mt-6 text-muted" hidden>No posts match your search.</p>
