---
// Shown only when PUBLIC_NEWSLETTER_URL is set (your email provider's form address), so there is never a dead box.
const url = import.meta.env.PUBLIC_NEWSLETTER_URL ?? '';
const field = import.meta.env.PUBLIC_NEWSLETTER_FIELD ?? 'email';
const { place = 'page' } = Astro.props;
---
{url && (
  <section class="my-16 rounded-2xl border border-rule bg-surface p-8" aria-labelledby={`signup-${place}`}>
    <h2 id={`signup-${place}`} class="font-head text-3xl font-bold uppercase tracking-wide text-ink">Get the weekly digest</h2>
    <p class="mt-2 max-w-xl text-muted">One email a week with our latest posts and how well each one is sourced. Unsubscribe any time.</p>
    <form class="mt-5 flex flex-wrap gap-3" action={url} method="post" target="_blank" rel="noopener" data-track="Newsletter signup">
      <label class="sr" for={`email-${place}`}>Email address</label>
      <input id={`email-${place}`} class="min-w-0 flex-1" type="email" name={field} required autocomplete="email" placeholder="you@example.com" />
      <button type="submit" class="cta">Subscribe</button>
    </form>
    <p class="mt-3 text-xs text-muted">We use your email only to send the digest. <a href="/privacy/">Privacy</a></p>
  </section>
)}
