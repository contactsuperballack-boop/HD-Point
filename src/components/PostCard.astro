---
import SourcingMeter from './SourcingMeter.astro';
import { fmtDate, TYPE_LABEL } from '../data/format';
const { post, lead = false } = Astro.props;
const d = post.data;
const kind = TYPE_LABEL[d.type] ?? d.type;
const text = `${d.title} ${d.summary} ${kind} ${d.region}`.toLowerCase();
---
<li class:list={['card', { 'lead-card': lead }]} data-text={text}>
  {d.image && <img src={d.image} alt="" width="1200" height="630" loading={lead ? 'eager' : 'lazy'} />}
  <div class="cardbody">
    <p class="meta">
      {kind}, {d.region || 'Africa'}, {fmtDate(d.date)}, {d.read} min read
      {d.sponsored && <span class="chip">Sponsored</span>}
      {d.draft && <span class="chip draft">Draft</span>}
    </p>
    <h2><a href={`/posts/${post.id}/`}>{d.title}</a></h2>
    <p class="sum">{d.summary}</p>
    <SourcingMeter verified={d.verified} stated={d.stated} />
  </div>
</li>
