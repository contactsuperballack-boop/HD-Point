---
import '../styles/global.css';
import cfg from '../../config.json';
import { allDigests } from '../data/digests';
import { TOPICS } from '../data/topics';

const { title, description = cfg.tagline, image, type = 'website', jsonLd } = Astro.props;
const SITE = cfg.siteName; // set in config.json
const groups = [
  { id: 'latest', label: 'Latest', href: '/' },
  { id: 'topics', label: 'Topics', items: TOPICS.map((t) => ({ label: t.label, href: `/topics/${t.slug}/` })) },
  { id: 'events', label: 'Events', href: '/events/' },
  { id: 'more', label: 'More', right: true, items: [
    ...(allDigests().length ? [{ label: 'Weekly digest', href: '/digest/' }] : []),
    { label: 'Data', href: '/data/' },
    { label: 'Corrections', href: '/corrections/' },
    { label: 'About', href: '/about/' },
    { label: 'How we verify', href: '/how-we-verify/' },
    { label: 'Submit a startup', href: '/submit/' },
    { label: 'RSS feed', href: '/rss.xml' },
    ...(cfg.contactEmail ? [{ label: 'Contact', href: `mailto:${cfg.contactEmail}` }] : []),
  ] },
];
const path = Astro.url.pathname;
const here = (href) => (href === '/' ? path === '/' : href.startsWith('/') && !href.endsWith('.xml') && path.startsWith(href));
const fullTitle = title ? `${title} | ${SITE}` : SITE;
const ogImage = Astro.site ? new URL(image || '/brand/og-default.png', Astro.site).href : undefined;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC ?? '';
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID ?? '';
const LABEL = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', youtube: 'YouTube', x: 'X', linkedin: 'LinkedIn' };
const social = Object.entries(cfg.social?.profiles ?? {}).filter(([, u]) => u);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D1017" />
    <link rel="alternate" type="application/rss+xml" title={SITE} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {analyticsSrc && <script defer src={analyticsSrc} data-domain={analyticsId} data-website-id={analyticsId}></script>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-3">
        <a class="inline-flex items-center no-underline" href="/" aria-label={SITE}>
          <picture>
            <source srcset="/brand/logo.svg" media="(prefers-color-scheme: light)" />
            <img class="block h-8 w-auto" src="/brand/logo-dark.svg" alt={SITE} width="112" height="34" />
          </picture>
        </a>
        <button class="menubtn" type="button" aria-expanded="false" aria-controls="mainnav">Menu</button>
        <nav id="mainnav" class="mainnav" aria-label="Main">
          <ul>
            {groups.map((g) => g.items ? (
              <li class:list={['dd', { right: g.right }]}>
                <button type="button" class:list={['ddbtn', { active: g.items.some((i) => here(i.href)) }]} aria-expanded="false" aria-controls={`dd-${g.id}`}>{g.label}</button>
                <ul class="ddpanel" id={`dd-${g.id}`}>
                  {g.items.map((i) => <li><a href={i.href} aria-current={here(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
                </ul>
              </li>
            ) : (
              <li><a class="nl" href={g.href} aria-current={here(g.href) ? 'page' : undefined}>{g.label}</a></li>
            ))}
            <li class="navcta"><a class="cta" href="/submit/">Submit a startup</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl px-5"><slot /></main>
    <footer class="mx-auto mt-28 w-full max-w-6xl border-t border-rule px-5 pt-12 pb-16">
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <p class="font-head text-2xl font-bold uppercase tracking-wide text-ink">{SITE}</p>
          <p class="mt-3 max-w-xs text-sm text-muted">{cfg.tagline}</p>
        </div>
        <nav aria-label="Topics">
          <p class="font-head text-sm font-semibold uppercase tracking-widest text-muted">Topics</p>
          <ul class="mt-3 grid list-none gap-2">
            {TOPICS.map((t) => <li><a class="font-head text-lg font-semibold uppercase tracking-wide text-ink no-underline hover:text-accent" href={`/topics/${t.slug}/`}>{t.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="More">
          <p class="font-head text-sm font-semibold uppercase tracking-widest text-muted">More</p>
          <ul class="mt-3 grid list-none gap-2">
            <li><a class="font-head text-lg font-semibold uppercase tracking-wide text-ink no-underline hover:text-accent" href="/about/">About</a></li>
            <li><a class="font-head text-lg font-semibold uppercase tracking-wide text-ink no-underline hover:text-accent" href="/how-we-verify/">How we verify</a></li>
            <li><a class="font-head text-lg font-semibold uppercase tracking-wide text-ink no-underline hover:text-accent" href="/submit/">Submit a startup</a></li>
            <li><a class="font-head text-lg font-semibold uppercase tracking-wide text-ink no-underline hover:text-accent" href="/events/">Events</a></li>
          </ul>
        </nav>
      </div>
      <div class="mt-10 flex flex-col gap-4 border-t border-rule pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
        <p>Posts are AI-assisted and linked to their sources. Sponsored posts are labelled.</p>
        <ul class="flex list-none flex-wrap items-center gap-x-5 gap-y-2">
          <li><a class="text-muted no-underline hover:text-ink" href="/corrections/">Corrections</a></li>
          <li><a class="text-muted no-underline hover:text-ink" href="/privacy/">Privacy</a></li>
          <li><a class="text-muted no-underline hover:text-ink" href="/rss.xml">RSS</a></li>
          {cfg.contactEmail && <li><a class="text-muted no-underline hover:text-ink" href={`mailto:${cfg.contactEmail}`}>Contact</a></li>}
          {social.map(([k, u]) => <li><a class="text-muted no-underline hover:text-ink" href={u} rel="noopener">{LABEL[k] ?? k}</a></li>)}
        </ul>
      </div>
    </footer>
    <script is:inline>
      (function () {
        window.track = function (name, props) { try { if (window.plausible) window.plausible(name, { props: props }); else if (window.umami && window.umami.track) window.umami.track(name, props); } catch (e) {} };
        document.addEventListener('submit', function (e) { var t = e.target && e.target.getAttribute && e.target.getAttribute('data-track'); if (t) window.track(t); });
        document.addEventListener('click', function (e) { var a = e.target.closest && e.target.closest('a[href^="http"]'); if (a && a.hostname !== location.hostname && a.closest('.prose')) window.track('Outbound source click', { host: a.hostname }); });
        var btns = [].slice.call(document.querySelectorAll('.ddbtn')), menu = document.querySelector('.menubtn'), nav = document.getElementById('mainnav');
        function setOpen(b, open) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); document.getElementById(b.getAttribute('aria-controls')).hidden = !open; }
        function closeAll(except) { btns.forEach(function (b) { if (b !== except) setOpen(b, false); }); }
        btns.forEach(function (b) {
          setOpen(b, false);
          b.addEventListener('click', function () { var open = b.getAttribute('aria-expanded') !== 'true'; closeAll(b); setOpen(b, open); });
        });
        if (menu) menu.addEventListener('click', function () { var o = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', o ? 'true' : 'false'); nav.classList.toggle('open', o); });
        document.addEventListener('click', function (e) { if (!e.target.closest('.dd')) closeAll(); });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var open = btns.filter(function (b) { return b.getAttribute('aria-expanded') === 'true'; })[0];
          closeAll(); if (open) open.focus();
        });
      })();
    </script>
  </body>
</html>
